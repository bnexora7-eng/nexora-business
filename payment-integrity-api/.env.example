PORT=8080
DATABASE_URL=postgres://nexora:change-me@localhost:5432/nexora
PROVIDER_SECRETS={"demo-provider":"replace-with-a-long-random-secret"}
REVIEW_THRESHOLD=10000
PGSSL=false
# Mollie test API key; add only in the server environment, never in the mobile app
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ENABLE_LIVE_PAYMENTS=false
PUBLIC_API_URL=https://nexora-payment-integrity-api.onrender.com
NEXORA_PAYMENT_RETURN_URL=https://bnexora7-eng.github.io/nexora-business/

# Transactional account emails (choose Gmail SMTP or Brevo; keep credentials server-side)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
NEXORA_ACCOUNT_URL=https://bnexora7-eng.github.io/nexora-business/account
# Optional alternative: Brevo API (takes precedence over SMTP when configured)
BREVO_API_KEY=
BREVO_FROM=

# Optional AI business planning provider; keep the key server-side only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible endpoint override
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions
