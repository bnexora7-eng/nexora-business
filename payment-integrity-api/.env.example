PORT=8080
DATABASE_URL=postgres://nexora:change-me@localhost:5432/nexora
PROVIDER_SECRETS={"demo-provider":"replace-with-a-long-random-secret"}
REVIEW_THRESHOLD=10000
PGSSL=false
# Mollie test API key; add only in the server environment, never in the mobile app
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ENABLE_LIVE_PAYMENTS=false
# Checkout is disabled by default; only enable after business/provider/legal approval.
ENABLE_ONE_OFF_PAYMENTS=false
# Operator-only quotation management; use a unique random secret of at least 40 characters.
QUOTE_ADMIN_TOKEN=
PUBLIC_API_URL=https://nexora-payment-integrity-api.onrender.com
NEXORA_PAYMENT_RETURN_URL=https://bnexora7-eng.github.io/nexora-business/

# Transactional account emails: Resend HTTPS API is preferred on the current Render Free service.
# Keep credentials server-side. A verified sending domain is required for customer email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
NEXORA_ACCOUNT_URL=https://bnexora7-eng.github.io/nexora-business/account
# Preferred provider: Resend. Use a sender address on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM=
# Set true only for controlled testing with onboarding@resend.dev; this cannot send to arbitrary users.
RESEND_ALLOW_TEST_SENDER=false
# Legacy fallback only; Resend takes precedence when RESEND_API_KEY is set.
BREVO_API_KEY=
BREVO_FROM=

# Optional AI business planning provider; keep the key server-side only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Zero disables all AI provider usage until an explicit budget is approved.
AI_MONTHLY_TOKEN_LIMIT=0
# Optional OpenAI-compatible endpoint override
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions
